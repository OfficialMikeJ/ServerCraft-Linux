# ServerCraft Linux Edition — Environment Variables
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# The installer and Docker compose will read .env automatically.

# ── Panel ──────────────────────────────────────────────────────────────────────
# Port the web panel listens on
PANEL_PORT=8080
SERVERCRAFT_PORT=8080

# Root directory used by the backend for resolving relative paths
# (leave unset to default to the backend/ directory itself)
# SERVERCRAFT_ROOT_DIR=/opt/servercraft/backend

